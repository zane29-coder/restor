# ---------------------------------------------------------------------------
# Production infrastructure secrets (docker-compose.prod.yml).
# Copy to `.env.prod` on the server. NEVER commit the real file.
#
# Generate each password with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

POSTGRES_USER=restor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=restor

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Apex domain served by nginx. One sub-domain per app — init-ssl.sh derives the
# full list from this and must match the `server_name`s in
# infrastructure/nginx/conf.d/restor.conf:
#
#   restor.uz  www  api  app (admin)  pos  kds  tg
DOMAIN=restor.uz

# Only override these if a host is named something other than <app>.$DOMAIN.
API_DOMAIN=api.restor.uz
ADMIN_DOMAIN=app.restor.uz
POS_DOMAIN=pos.restor.uz
KDS_DOMAIN=kds.restor.uz
MINIAPP_DOMAIN=tg.restor.uz

# Where Let's Encrypt sends expiry warnings.
CERTBOT_EMAIL=admin@restor.uz
