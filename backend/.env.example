# =============================================================================
# RESTOR backend environment (TZ §54)
#
# Copy to `backend/.env` and fill in. NEVER commit the real `.env`.
# Every variable is validated at boot by src/config/env.validation.ts — the
# process refuses to start on a bad value rather than failing at 3am under load.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API (TZ §52).
# Use exact origins in production; "*" is rejected when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
# Public base URL of this API, used to build absolute file URLs.
API_BASE_URL=http://localhost:3000
# Public base URL of the customer storefront, used for QR table links (TZ §29).
CUSTOMER_WEB_URL=http://localhost:5174

# --- Database (TZ §40) ---
DATABASE_URL=postgresql://restor:restor@localhost:5432/restor?schema=public

# --- Redis: cache, queues, rate limiting (TZ §56) ---
REDIS_URL=redis://localhost:6379

# --- Auth (TZ §52) ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be at least 32 characters. Use DIFFERENT values for access and refresh:
# sharing one secret means a stolen refresh token is also a valid access token.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value-min-32-chars
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-value-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Failed logins before the account is temporarily locked.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15

# --- Encryption for secrets stored in the DB (bot tokens, provider keys) ---
# Exactly 32 bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Rate limiting (TZ §52) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# --- File storage (TZ §39): LOCAL | S3 | MINIO ---
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE_MB=10
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=restor
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# --- Telegram (TZ §14, §15) ---
# The platform-wide RESTOR bot. Tenants may configure their own bot instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Mini App initData signatures are only valid for this many seconds (TZ §48).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Payment providers (TZ §35, §36) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
PAYME_MERCHANT_ID=
PAYME_SECRET=

# --- Logging & monitoring (TZ §59, §60) ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=

# --- Background jobs (TZ §57) ---
QUEUE_PREFIX=restor
# Set false on a web-only instance when workers run as a separate process.
QUEUE_WORKERS_ENABLED=true

# --- Courier tracking (TZ §25) ---
COURIER_LOCATION_RETENTION_DAYS=30
