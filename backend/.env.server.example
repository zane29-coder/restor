# =============================================================================
# RESTOR backend environment — SHARED-HOST deployment, one sub-domain per app.
#
# Copy to `backend/.env.server` on the server. NEVER commit the real file.
#
# DATABASE_URL and REDIS_URL are injected by docker-compose.server.yml — leave
# them out of this file or they will override the container's own network
# addresses with something only the host can reach.
#
# Every variable is validated at boot by src/config/env.validation.ts. The API
# refuses to start on a bad value: a misconfiguration should stop the deploy,
# not surface as a breach later.
# =============================================================================

NODE_ENV=production
PORT=3000

# --- Public URLs -------------------------------------------------------------

# Browser origins allowed to call the API (TZ §52). Every app proxies /api/ on
# its own host, so these are only needed for a client that is genuinely
# cross-origin — but an exact list costs nothing and is what makes a stray
# origin visible in the logs. `*` is rejected when NODE_ENV=production.
CORS_ORIGINS=https://restor.uz,https://www.restor.uz,https://app.restor.uz,https://pos.restor.uz,https://kds.restor.uz,https://tg.restor.uz

# This API's public base. Two things are built from it and both are
# long-lived, so changing it later is not free:
#   * every image URL written to the database (products, categories, logos,
#     avatars) — see docs/deployment-shared-host.md for the UPDATE that
#     rewrites rows created under an older host
#   * the callback URL advertised to the payment provider
API_BASE_URL=https://api.restor.uz

# Storefront base, used to build the dine-in QR links `/t/{qrToken}` (TZ §29).
# A printed QR code cannot be edited, so this must be the final public host.
CUSTOMER_WEB_URL=https://restor.uz

# --- Auth (TZ §52) -----------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters, and the two MUST differ: sharing one secret means a
# stolen refresh token is also a valid access token.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15

# --- Encryption for secrets stored in the DB (bot tokens, provider keys) -----
# Exactly 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this orphans every value already encrypted with the old key.
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# --- Rate limiting (TZ §52) --------------------------------------------------
# The app's own throttler. nginx limits in front of it as a second line.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# --- File storage (TZ §39) ---------------------------------------------------
# LOCAL writes to ./storage, which is bind-mounted and served by the host nginx
# straight off disk. Switch to S3/MinIO before running more than one API
# container — local disk is not shared between them.
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE_MB=10

# --- Telegram (TZ §14, §15) --------------------------------------------------
# The platform-wide bot; tenants may configure their own instead. The Mini App
# is served from https://tg.restor.uz — register that URL in @BotFather
# (/newapp, or Bot Settings → Menu Button). It is not read from here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Payment providers (TZ §35, §36) -----------------------------------------
# The callback URL is derived from API_BASE_URL, so register
# https://api.restor.uz/api/v1/webhooks/... with the provider.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
PAYME_MERCHANT_ID=
PAYME_SECRET=

# --- Logging & monitoring (TZ §59, §60) --------------------------------------
LOG_LEVEL=info
# Pretty printing is for a terminal; the server's logs are read by a collector.
LOG_PRETTY=false
SENTRY_DSN=

# --- Background jobs (TZ §57) ------------------------------------------------
QUEUE_PREFIX=restor
QUEUE_WORKERS_ENABLED=true

# --- Courier tracking (TZ §25) -----------------------------------------------
COURIER_LOCATION_RETENTION_DAYS=30
