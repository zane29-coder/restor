# ---------------------------------------------------------------------------
# Infrastructure secrets for the SHARED-HOST deployment
# (docker-compose.server.yml + the host's own nginx).
#
# Copy to `.env.server` on the server. NEVER commit the real file.
#
# Generate each password with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

POSTGRES_USER=restor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=restor

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Loopback port the host nginx proxies to. 3000 is taken by another app on this
# server, which is why the default is 3100 — see docker-compose.server.yml.
API_HOST_PORT=3100

# Apex domain. The deploy script derives every app host from it
# (app., pos., kds., tg., api.) and verifies each one after reloading nginx.
RESTOR_DOMAIN=restor.uz

# Where Let's Encrypt sends expiry warnings. Read by init-ssl-host.sh.
CERTBOT_EMAIL=admin@restor.uz
