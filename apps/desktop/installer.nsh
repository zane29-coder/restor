; NSIS uses 1091 for Latin Uzbek; electron-builder's locale table uses 2115.
; Supply the actual installer language strings explicitly.
!macro customHeader
  LangString chooseInstallationOptions 1091 "O'rnatish sozlamalari"
  LangString chooseUninstallationOptions 1091 "O'chirish sozlamalari"
  LangString whichInstallationShouldBeRemoved 1091 "Qaysi o'rnatilgan dastur o'chirilsin?"
  LangString whoShouldThisApplicationBeInstalledFor 1091 "Dastur kim uchun o'rnatilsin?"
  LangString selectUserMode 1091 "Faqat o'zingiz uchun o'rnatishni tanlang."
  LangString whichInstallationRemove 1091 "O'chiriladigan o'rnatishni tanlang."
  LangString freshInstallForAll 1091 "Barcha foydalanuvchilar uchun yangi o'rnatish."
  LangString freshInstallForCurrent 1091 "Joriy foydalanuvchi uchun yangi o'rnatish."
  LangString onlyForMe 1091 "Faqat &men uchun"
  LangString forAll 1091 "&Barcha foydalanuvchilar uchun"
  LangString loginWithAdminAccount 1091 "Davom etish uchun administrator hisobi kerak."
  LangString perUserInstallExists 1091 "Bu foydalanuvchi uchun dastur o'rnatilgan."
  LangString perUserInstall 1091 "Foydalanuvchi uchun o'rnatish mavjud."
  LangString perMachineInstallExists 1091 "Barcha foydalanuvchilar uchun dastur o'rnatilgan."
  LangString perMachineInstall 1091 "Umumiy o'rnatish mavjud."
  LangString reinstallUpgrade 1091 "Dastur qayta o'rnatiladi yoki yangilanadi."
  LangString uninstall 1091 "Dastur o'chiriladi."
  LangString win7Required 1091 "Windows 10 yoki 11 talab qilinadi."
  LangString x64WinRequired 1091 "64-bit Windows talab qilinadi."
  LangString appRunning 1091 "${PRODUCT_NAME} ochiq. Uni yoping va davom eting."
  LangString appCannotBeClosed 1091 "Dasturni yoping, keyin qayta urinib ko'ring."
  LangString installing 1091 "O'rnatilmoqda, kuting..."
  LangString areYouSureToUninstall 1091 "${PRODUCT_NAME} o'chirilsinmi?"
  LangString decompressionFailed 1091 "Fayllar ochilmadi. O'rnatuvchini qayta ishga tushiring."
  LangString uninstallFailed 1091 "Eski fayllar o'chirilmadi. Qayta urinib ko'ring."
  LangString appClosing 1091 "${PRODUCT_NAME} yopilmoqda..."
  LangString MULTIUSER_TEXT_INSTALLMODE_TITLE 1091 "Foydalanuvchini tanlang"
  LangString MULTIUSER_TEXT_INSTALLMODE_SUBTITLE 1091 "Dastur kim uchun o'rnatilishini tanlang."
  LangString MULTIUSER_INNERTEXT_INSTALLMODE_TOP 1091 "Joriy foydalanuvchini tanlang va davom eting."
  LangString MULTIUSER_INNERTEXT_INSTALLMODE_ALLUSERS 1091 "Barcha foydalanuvchilar uchun"
  LangString MULTIUSER_INNERTEXT_INSTALLMODE_CURRENTUSER 1091 "Faqat men uchun"
!macroend
